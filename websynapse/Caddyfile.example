# ============================================================================
# Hardened Production Caddyfile for websynap.se
# Automatic HTTPS + Strict WebHID Permissions-Policy & Zero-Network CSP
#
# IMPORTANT: Do NOT deploy serve-local.js, README.md, SECURITY.md, _headers, or *.example.
# ============================================================================

websynap.se {
    root * /var/www/websynap.se
    encode zstd gzip

    # Access logs: rotate and keep for at most 7 days (matches the privacy policy).
    # Ensure /var/log/caddy exists and is writable by the Caddy user.
    log {
        output file /var/log/caddy/websynap-access.log {
            roll_size 10MiB
            roll_keep 5
            roll_keep_for 168h
        }
        format json
    }

    # Reject all HTTP methods except GET and HEAD
    @disallowed_methods not method GET HEAD
    respond @disallowed_methods 405

    # Explicitly block dotfiles and non-public repo files (serve-local.js, README.md, SECURITY.md, *.example, _headers)
    @blocked_files path .* /serve-local.js /_headers *.example *.md
    respond @blocked_files 404

    header {
        -Server
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'none'; font-src 'self'; media-src 'none'; object-src 'none'; child-src 'none'; frame-src 'none'; frame-ancestors 'none'; worker-src 'self' blob:; base-uri 'none'; form-action 'none';"
        Permissions-Policy "hid=(self), usb=(), serial=(), bluetooth=(), camera=(), microphone=(), geolocation=(), payment=(), accelerometer=(), gyroscope=(), magnetometer=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    file_server
}
